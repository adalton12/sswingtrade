# SSWingTrade Environment Configuration
# Copy to .env and adjust values for your environment

# ========== Application ==========
APP_NAME=SSWingTrade
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=DEBUG

# ========== Database ==========
DATABASE_URL=postgresql://trading:trading_dev_pwd@postgres:5432/sswingtrade
DATABASE_ECHO=True
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600

# ========== Cache/Redis ==========
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# ========== Ollama (Local LLM) ==========
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=30

# ========== Trading Capital Management ==========
INITIAL_CAPITAL=500.00
MONTHLY_DEPOSIT=500.00
MAX_DAILY_ALLOCATION=100.00
MAX_WEEKLY_CAPITAL=500.00
MAX_DAILY_LOSS_PERCENT=1.5

# ========== Position Sizing & Risk ==========
POSITION_SIZE_DYNAMIC=True
STOP_LOSS_ATR_MULTIPLIER=1.5
TAKE_PROFIT_RATIO=2.0
MIN_SCORE_TO_TRADE=60.0

# ========== Feature Flags ==========
ENABLE_PAPER_TRADING=True
ENABLE_REAL_TRADING=False
ENABLE_LLM_ANALYSIS=True
ENABLE_ML_MODELS=True

# ========== Market Data ==========
MARKET_DATA_SOURCE=yfinance
MARKET_DATA_UPDATE_FREQUENCY=daily
MARKET_TIMEZONE=America/Sao_Paulo

# ========== Monitoring ==========
PROMETHEUS_ENABLED=True
PROMETHEUS_METRICS_PORT=9090
OTEL_TRACING_ENABLED=False
OTEL_COLLECTOR_ENDPOINT=http://localhost:4317

# ========== Logging ==========
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/sswingtrade.log
LOG_ROTATION=10 MB

# ========== API & CORS ==========
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]
API_RATE_LIMIT=1000
API_TIMEOUT=30

# ========== Security ==========
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
