# SSWingTrade - configuration for docker compose.
#
#   1. copy this file to ".env"   (cp .env.example .env)
#   2. replace every CHANGE_ME with a long random value, e.g.:  python -c "import secrets; print(secrets.token_hex(16))"
#      (use letters and digits only: these values are embedded in connection URLs)
#   3. docker compose up -d --build
#
# ".env" holds secrets and is git-ignored. Never commit it.

# ========== Secrets (REQUIRED: compose refuses to start without them) ==========
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME                     # signs the Risk Engine's order approvals

# ========== Database / Grafana users (optional) ==========
POSTGRES_USER=trading
POSTGRES_DB=sswingtrade
GRAFANA_ADMIN_USER=admin

# ========== Ollama (the one installed on this PC, not a container) ==========
# The API reaches the PC through host.docker.internal. Start Ollama before the 19:30 news job.
# Run `ollama list` to see your models; the agents work best with a small, non-reasoning model
# (qwen2.5:3b is the project default). Reasoning is switched off in the client, so qwen3 works too.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120

# Ollama CLOUD (optional). Create a key at https://ollama.com/settings/keys and paste it here, in this file only
# (never in chat, code or git). Empty = cloud off, everything runs on the local model above.
# With a key: the text agents (research, devil's advocate, events) try the cloud model first and fall back to the
# local one if the cloud fails or the free quota runs out. The nightly news batch stays local unless you turn on
# "Lote de notícias na nuvem" in /settings (it makes ~40 calls a day).
# To rotate the key: edit this line, then `docker compose up -d` (recreates only what changed).
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gemma4:31b

# ========== Application (optional) ==========
APP_ENV=development                      # only changes the console log format (production = JSON lines)
LOG_LEVEL=INFO

# Starting values. Once the app is running, change everything in http://localhost:8000/settings instead.
INITIAL_CAPITAL=500
WEEKLY_DEPOSIT=500
MONTHLY_DEPOSIT=500
MAX_DAILY_LOSS_PERCENT=1.5

# ENABLE_REAL_TRADING is fixed to false in docker-compose.yml on purpose (no real broker exists yet).
