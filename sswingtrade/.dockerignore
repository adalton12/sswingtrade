# Keep the build context small and keep secrets out of the image
.git
.gitignore
.env
.env.*
!.env.example

**/__pycache__
**/*.pyc
.pytest_cache
.coverage
htmlcov
.venv
venv

# Not needed inside the image (the Dockerfile only copies requirements.txt and app/)
tests
logs
models
requirements-dev.txt
pytest.ini
*.md
PROJECT_STRUCTURE.txt
docker/grafana
docker/prometheus
docker/postgres
docker-compose.yml
